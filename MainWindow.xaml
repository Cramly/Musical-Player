<Window x:Class="ПлеерОганян.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ПлеерОганян"
        mc:Ignorable="d"
        Title="Плеер" Height="720" Width="1280">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Content="Библиотека"
                            Padding="10,6"
                            Command="{Binding OpenLibraryCommand}" />

                    <TextBlock Grid.Row="2"
                               FontWeight="SemiBold"
                               Text="Плейлисты" />

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding Playlists}"
                             SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                             DisplayMemberPath="Name" />

                    <StackPanel Grid.Row="6" Orientation="Horizontal">
                        <Button Content="Создать"
                                Width="90"
                                Margin="0,0,8,0"
                                Padding="10,6"
                                Command="{Binding CreatePlaylistCommand}" />
                        <Button Content="Удалить"
                                Width="90"
                                Padding="10,6"
                                Command="{Binding DeletePlaylistCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox Height="30"
                             Padding="8,4"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <ComboBox Width="220"
                                  Margin="0,0,8,0"
                                  ItemsSource="{Binding Playlists}"
                                  SelectedItem="{Binding SelectedPlaylistForAdd, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                        <Button Content="Добавить в плейлист"
                                Padding="10,6"
                                Command="{Binding AddToPlaylistCommand}" />
                    </StackPanel>

                    <ListBox Grid.Row="4"
                             ItemsSource="{Binding DisplayedTracksView}"
                             SelectedItem="{Binding SelectedTrack, Mode=TwoWay}">
                        <ListBox.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding AddToQueueAndPlayCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Artist}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Album}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Genre}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding DurationText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="4" Padding="12" BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock FontWeight="SemiBold"
                               Text="Now Playing Queue" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding QueueTracks}"
                             SelectedItem="{Binding SelectedQueueTrack, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Artist}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button Content="Удалить"
                                Width="100"
                                Margin="0,0,8,0"
                                Padding="10,6"
                                Command="{Binding RemoveQueueTrackCommand}" />
                        <Button Content="Очистить"
                                Width="100"
                                Padding="10,6"
                                Command="{Binding ClearQueueCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="12" BorderBrush="#DDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel>
                    <Button Content="Загрузить папку"
                            Width="140"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Command="{Binding LoadFolderCommand}" />
                    <Button Content="Previous"
                            Width="80"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Command="{Binding PreviousCommand}" />
                    <Button Content="Play"
                            Width="80"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Command="{Binding PlayCommand}" />
                    <Button Content="Pause"
                            Width="80"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Command="{Binding PauseCommand}" />
                    <Button Content="Stop"
                            Width="80"
                            Padding="10,6"
                            Margin="0,0,8,8"
                            Command="{Binding StopCommand}" />
                    <Button Content="Next"
                            Width="80"
                            Padding="10,6"
                            Margin="0,0,12,8"
                            Command="{Binding NextCommand}" />

                    <CheckBox Content="Shuffle"
                              VerticalAlignment="Center"
                              Margin="0,0,12,8"
                              IsChecked="{Binding IsShuffleEnabled, Mode=TwoWay}" />
                    <CheckBox Content="Repeat Track"
                              VerticalAlignment="Center"
                              Margin="0,0,12,8"
                              IsChecked="{Binding IsRepeatTrackEnabled, Mode=TwoWay}" />
                    <CheckBox Content="Repeat Playlist"
                              VerticalAlignment="Center"
                              Margin="0,0,12,8"
                              IsChecked="{Binding IsRepeatPlaylistEnabled, Mode=TwoWay}" />

                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,8,8"
                               Text="Volume" />
                    <Slider Width="120"
                            Minimum="0"
                            Maximum="1"
                            TickFrequency="0.1"
                            Value="{Binding Volume, Mode=TwoWay}" />
                </WrapPanel>

                <Slider Grid.Row="2"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding SliderPosition, Mode=TwoWay}" />

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding CurrentPositionText}" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedTrackTitle}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding DurationText}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

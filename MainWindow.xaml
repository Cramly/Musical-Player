<Window x:Class="ПлеерОганян.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ПлеерОганян"
        mc:Ignorable="d"
        Title="Библиотека" Height="580" Width="980">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="Загрузить папку"
                    Width="140"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Command="{Binding LoadFolderCommand}" />
            <Button Content="Previous"
                    Width="80"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Command="{Binding PreviousCommand}" />
            <Button Content="Play"
                    Width="80"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Command="{Binding PlayCommand}" />
            <Button Content="Pause"
                    Width="80"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Command="{Binding PauseCommand}" />
            <Button Content="Stop"
                    Width="80"
                    Padding="10,6"
                    Margin="0,0,8,0"
                    Command="{Binding StopCommand}" />
            <Button Content="Next"
                    Width="80"
                    Padding="10,6"
                    Margin="0,0,12,0"
                    Command="{Binding NextCommand}" />

            <CheckBox Content="Shuffle"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      IsChecked="{Binding IsShuffleEnabled, Mode=TwoWay}" />
            <CheckBox Content="Repeat Track"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      IsChecked="{Binding IsRepeatTrackEnabled, Mode=TwoWay}" />
            <CheckBox Content="Repeat Playlist"
                      VerticalAlignment="Center"
                      Margin="0,0,12,0"
                      IsChecked="{Binding IsRepeatPlaylistEnabled, Mode=TwoWay}" />

            <TextBlock VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Text="Volume" />
            <Slider Width="120"
                    Minimum="0"
                    Maximum="1"
                    TickFrequency="0.1"
                    Value="{Binding Volume, Mode=TwoWay}" />
        </StackPanel>

        <TextBox Grid.Row="2"
                 Height="30"
                 Padding="8,4"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Slider Grid.Row="4"
                Minimum="0"
                Maximum="100"
                Value="{Binding SliderPosition, Mode=TwoWay}" />

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding CurrentPositionText}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding DurationText}" />
        </Grid>

        <ListBox Grid.Row="8"
                 ItemsSource="{Binding TracksView}"
                 SelectedItem="{Binding SelectedTrack, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Artist}"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Album}"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Genre}"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding DurationText}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="10"
                   FontWeight="SemiBold"
                   Text="{Binding SelectedTrackTitle}" />
    </Grid>
</Window>
